<section class="hero" data-hero data-autoplay="{{ section.settings.autoplay }}" data-autoplay-speed="{{ section.settings.autoplay_speed }}">
  <div class="hero__slides">
    {%- for block in section.blocks -%}
      {%- if block.type == 'slide' -%}
        <div class="hero__slide {% if forloop.first %}is-active{% endif %}" data-hero-slide {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img
              src="{{ block.settings.image | image_url: width: 1600 }}"
              srcset="{{ block.settings.image | image_url: width: 800 }} 800w, {{ block.settings.image | image_url: width: 1600 }} 1600w, {{ block.settings.image | image_url: width: 2000 }} 2000w"
              sizes="100vw"
              alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            >
          {%- else -%}
            <div class="hero__slide-placeholder"></div>
          {%- endif -%}
          <div class="hero__content hero__content--{{ block.settings.text_position }}">
            {%- if block.settings.heading != blank -%}<h1>{{ block.settings.heading }}</h1>{%- endif -%}
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a href="{{ block.settings.button_link }}" class="button button--primary">{{ block.settings.button_label }}</a>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <button class="hero__nav hero__nav--prev" data-hero-prev aria-label="Anterior">{%- render 'icon', icon: 'chevron' -%}</button>
    <button class="hero__nav hero__nav--next" data-hero-next aria-label="Próximo">{%- render 'icon', icon: 'chevron' -%}</button>
    <div class="hero__dots" data-hero-dots>
      {%- for block in section.blocks -%}
        <button class="hero__dot {% if forloop.first %}is-active{% endif %}" data-hero-dot="{{ forloop.index0 }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Banner principal",
  "settings": [
    { "type": "checkbox", "id": "autoplay", "label": "Rotação automática", "default": true },
    { "type": "range", "id": "autoplay_speed", "label": "Velocidade (segundos)", "min": 3, "max": 10, "step": 1, "default": 5 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagem" },
        { "type": "text", "id": "heading", "label": "Título", "default": "Escolhas inteligentes." },
        { "type": "text", "id": "text", "label": "Subtítulo", "default": "Produtos selecionados com curadoria." },
        { "type": "text", "id": "button_label", "label": "Texto do botão", "default": "Ver produtos" },
        { "type": "url", "id": "button_link", "label": "Link do botão" },
        { "type": "select", "id": "text_position", "label": "Posição do texto", "default": "left", "options": [
          { "value": "left", "label": "Esquerda" },
          { "value": "center", "label": "Centro" },
          { "value": "right", "label": "Direita" }
        ]}
      ]
    }
  ],
  "presets": [
    {
      "name": "Banner principal",
      "blocks": [{ "type": "slide" }]
    }
  ]
}
{% endschema %}
