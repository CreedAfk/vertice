<section class="collection">
  <div class="collection__header">
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="collection__description rte">{{ collection.description }}</div>
    {%- endif -%}
  </div>

  <div class="product-grid product-grid--4">
    {%- paginate collection.products by 24 -%}
      {%- for product in collection.products -%}
        {%- render 'product-card', product: product -%}
      {%- endfor -%}

      {%- if paginate.pages > 1 -%}
        <div class="pagination">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">Anterior</a>{%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- else -%}<span class="is-active">{{ part.title }}</span>{%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Próxima</a>{%- endif -%}
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Grade da coleção", "settings": [] }
{% endschema %}
